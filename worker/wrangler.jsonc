{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "task-mania",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/storage/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "task-mania",
      "database_id": "1bb12d1c-9fd9-4f66-89c0-1d8633fa10de",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "task-mania-files" }],
  "vars": {
    "APP_TIMEZONE": "Asia/Manila",
    "ACCESS_TEAM_DOMAIN": "https://weathered-rain-8654.cloudflareaccess.com",
    "ACCESS_AUD": "b266dac00d705dc3eece4416d0ce1a280b7c7215aa82507a98eb32db2835843c"
  },
  "observability": { "enabled": true }
}
